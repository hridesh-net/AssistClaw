# AssistClaw Environment Variables
# Copy this file to .env and fill in your keys.
# Most ASSISTCLAW_* vars also accept the provider-native form (e.g. OPENAI_API_KEY).

# ─────────────────────────────────────────────
# LLM Providers (configure at least one)
# ─────────────────────────────────────────────

# OpenAI / Azure OpenAI
ASSISTCLAW_OPENAI_API_KEY=
ASSISTCLAW_OPENAI_ORG_ID=
# ASSISTCLAW_AZURE_OPENAI_API_KEY=
# ASSISTCLAW_AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai
# ASSISTCLAW_AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic
ASSISTCLAW_ANTHROPIC_API_KEY=

# AWS Bedrock (uses AWS SDK credential chain — configure via ~/.aws or IAM role)
# ASSISTCLAW_BEDROCK_REGION=us-east-1
# ASSISTCLAW_BEDROCK_PROFILE=default

# Google Vertex AI / Gemini
# ASSISTCLAW_GOOGLE_API_KEY=              (for Gemini direct API)
# ASSISTCLAW_VERTEX_PROJECT_ID=
# ASSISTCLAW_VERTEX_LOCATION=us-central1

# Local providers (no key required)
# ASSISTCLAW_OLLAMA_BASE_URL=http://localhost:11434
# ASSISTCLAW_VLLM_BASE_URL=http://localhost:8000
# ASSISTCLAW_VLLM_API_KEY=                    (optional)
# ASSISTCLAW_LM_STUDIO_BASE_URL=http://localhost:1234

# Speed / cost optimized cloud providers
ASSISTCLAW_GROQ_API_KEY=
ASSISTCLAW_MISTRAL_API_KEY=
ASSISTCLAW_TOGETHER_API_KEY=
ASSISTCLAW_OPENROUTER_API_KEY=
ASSISTCLAW_OPENROUTER_SITE_NAME=AssistClaw
ASSISTCLAW_OPENROUTER_SITE_URL=https://assistclaw.io

# NVIDIA NIM
# ASSISTCLAW_NVIDIA_API_KEY=

# Cohere
ASSISTCLAW_COHERE_API_KEY=

# HuggingFace Inference API
# ASSISTCLAW_HUGGINGFACE_API_KEY=

# ─────────────────────────────────────────────
# Embedding Models
# ─────────────────────────────────────────────
# Defaults: uses OpenAI if key is set, falls back to Ollama (local).
# Override per-provider in assistclaw.yaml.

# ─────────────────────────────────────────────
# Messaging Channels
# ─────────────────────────────────────────────
ASSISTCLAW_TELEGRAM_BOT_TOKEN=
ASSISTCLAW_DISCORD_BOT_TOKEN=
ASSISTCLAW_SLACK_BOT_TOKEN=
ASSISTCLAW_SLACK_APP_TOKEN=

# ─────────────────────────────────────────────
# Gateway
# ─────────────────────────────────────────────
# ASSISTCLAW_GATEWAY_HOST=127.0.0.1
# ASSISTCLAW_GATEWAY_PORT=18790
# ASSISTCLAW_GATEWAY_TOKEN=               (bearer token for REST API auth)

# ─────────────────────────────────────────────
# Tooling / Search
# ─────────────────────────────────────────────
# ASSISTCLAW_FIRECRAWL_API_KEY=           (web scraping)
# ASSISTCLAW_BRAVE_SEARCH_API_KEY=        (web search)
# ASSISTCLAW_TAVILY_API_KEY=              (web search alternative)

# ─────────────────────────────────────────────
# Hardware Sensing
# ─────────────────────────────────────────────
# ASSISTCLAW_CAMERA_ENABLED=0
# ASSISTCLAW_CAMERA_DEVICE=0
# ASSISTCLAW_AUDIO_ENABLED=0

# ─────────────────────────────────────────────
# State directory (default: ~/.assistclaw)
# ─────────────────────────────────────────────
# ASSISTCLAW_STATE_DIR=~/.assistclaw
