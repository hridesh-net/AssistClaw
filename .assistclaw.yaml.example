# AssistClaw Configuration Example
#
# Copy this file to ~/.assistclaw/assistclaw.yaml and customize.

version: 1

# Base directory for memory, tools, and skills
state_dir: "~/.assistclaw"

# Gateway settings (REST/WebSocket server)
gateway:
  host: "127.0.0.1"
  port: 18789
  token: ""

# Agent Execution settings
agent:
  max_iterations: 64
  system_prompt_ext: "" # Extra instructions appended to the global system prompt

# Multi-model Routing
routing:
  default: "anthropic/claude-3-5-haiku-20241022"
  fallback: "ollama/llama3.2"
  rules:
    - task: "code"
      model: "anthropic/claude-3-7-sonnet-20250219"

# Memory Configuration
memory:
  working_token_budget: 100000

# Channel Messaging
channels:
  outbound:
    max_attempts: 5
    base_delay_ms: 250
    max_delay_ms: 10000
    jitter_percent: 0.2
    breaker_threshold: 5
    breaker_cooldown_s: 30
    dlq_path: "~/.assistclaw/channels/dlq.ndjson"
  telegram:
    bot_token: ""
    require_mention: true
  discord:
    bot_token: ""
    dm_mode: "pairing"
    require_mention: true

# Embedding Models (Priority defines fallback order)
embeddings:
  priority:
    - "openai"
    - "ollama"

# Optional OpenTelemetry tracing (off by default for edge performance)
tracing:
  enabled: false
  otlp_endpoint: "localhost:4317"
  service_name: "assistclaw"
  sample_ratio: 0.01

# Provider Configurations
providers:
  anthropic:
    api_key: ""
  openai:
    api_key: ""
  ollama:
    base_url: "http://127.0.0.1:11434"
    default_model: "llama3.2"
  groq:
    api_key: ""
  openrouter:
    api_key: ""
